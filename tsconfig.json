/* Copyright(C) 2017-2026, HJD (https://github.com/hjdhjd). All rights reserved.
 *
 * tsconfig.json: Project declaration discovered by IDEs and typescript-eslint's project service, and the type-check pass (`npm run typecheck`). It type-checks
 * everything under `src`, the settings page's modules in `src/webui` among it, with the colocated test, fixtures, and helpers files tsconfig.build.json leaves out of
 * the package included. `noEmit` keeps `tsc -p tsconfig.json` from producing build output - emitting the published `dist/` is exclusively tsconfig.build.json's job.
 * The web UI's JavaScript and eslint.config.mjs are not inputs here: typescript-eslint lints them through the default project that eslint.config.mjs's
 * allowDefaultProject list names. Both projects extend homebridge-plugin-utils' plugin profile, which turns declaration emit off over the family's shared base: a
 * plugin publishes no types.
 */
{
  "compilerOptions": {

    "noEmit": true
  },

  "exclude": [ "dist", "node_modules" ],
  "extends": "./node_modules/homebridge-plugin-utils/build/tsconfig.plugin.json",
  "include": [ "src" ]
}
